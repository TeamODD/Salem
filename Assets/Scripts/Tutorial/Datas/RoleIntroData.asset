MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb656b7b27076ad4c8e1f6014ad9e1e3, type: 3}
  m_Name: RoleIntroData
  m_EditorClassIdentifier: Assembly-CSharp::RoleIntroData
  AllRoles:
  - RoleName: "\uB9C8\uB140"
    RoleIcon: {fileID: 2268611225842031014, guid: 155ea4f1494b5a34ab6c3b68c14f25b6, type: 3}
    RoleDescription: "\uB9E4\uC77C \uBC24 \uAC81\uC7C1\uC774\uB97C \uC81C\uC678\uD55C
      \uD55C \uBA85\uC744 \uC0B4\uD574\uD569\uB2C8\uB2E4. \uCCAB \uD76C\uC0DD\uC790\uC5D0
      \uB530\uB77C \uC2E0\uC790 \uD639\uC740 \uD0C0\uC778\uC758 \uC2E0\uBD84\uC744
      \uC0AC\uCE6D\uD558\uBA70, \uC0AC\uCE6D\uD55C \uC9C1\uC5C5\uC758 \uD589\uB3D9
      \uD328\uD134\uACFC \uD2B9\uC218 \uB300\uC0AC\uB97C \uC0AC\uC6A9\uD558\uC5EC
      \uC815\uCCB4\uB97C \uC228\uAE30\uACE0 \uB9C8\uC744\uC744 \uAE30\uB9CC\uD569\uB2C8\uB2E4."
  - RoleName: "\uC2E0\uC790"
    RoleIcon: {fileID: 1287633194998006098, guid: 7bdee89d5dea2644aaeba963e0d9464b, type: 3}
    RoleDescription: "\uC790\uC2E0\uC744 \uC81C\uC678\uD55C \uD55C \uBA85\uC758 \uC9D1\uC5D0
      \uBC24\uB9C8\uB2E4 \uB79C\uB364\uC73C\uB85C \uBC29\uBB38\uD558\uC5EC \uD568\uAED8
      \uAE30\uB3C4\uB97C \uD569\uB2C8\uB2E4. \uC774\uC804\uC5D0 \uAE30\uB3C4\uB97C
      \uD588\uB358 \uB300\uC0C1\uC740 \uC81C\uC678\uB429\uB2C8\uB2E4. "
  - RoleName: "\uC880\uB3C4\uB451"
    RoleIcon: {fileID: 2742689383411699323, guid: 5a634219ff9cf3e478bb991aa4e15767, type: 3}
    RoleDescription: "\uBC24\uC5D0 \uBE44\uC5B4\uC788\uB294 \uC9D1(\uC2E0\uC790,
      \uBD88\uBA74\uC99D)\uC744 \uCC3E\uC544 \uB3C4\uB451\uC9C8\uC744 \uC2DC\uB3C4\uD569\uB2C8\uB2E4.
      \uC131\uACF5 \uC2DC \uD574\uB2F9 \uC9C1\uC5C5\uC758 \uD398\uB974\uC18C\uB098\uB97C
      \uC5BB\uC5B4 \uC644\uBCBD\uD558\uAC8C \uC5F0\uAE30\uD558\uBA70, \uB3C4\uB451\uC9C8\uC774
      \uBD88\uAC00\uB2A5\uD560 \uACBD\uC6B0 \uC77C\uBC18 \uC2DC\uBBFC\uCC98\uB7FC
      \uD589\uB3D9\uD558\uBA70 \uAE30\uD68C\uB97C \uC5FF\uBD05\uB2C8\uB2E4."
  - RoleName: "\uBD88\uBA74\uC99D"
    RoleIcon: {fileID: -5458539718955532933, guid: 4ee058aea9c653d4dbaff62049c3c244, type: 3}
    RoleDescription: "\uD640\uC218 \uB0A0\uC5D0\uB294 \uC9D1\uC5D0 \uBA38\uBB3C\uB7EC
      \uAE30\uB3C4\uB97C \uBC1B\uACE0 \uB0AE\uC5D0 \uC774\uB97C \uC99D\uC5B8\uD558\uBA70,
      \uC9DD\uC218 \uB0A0\uC5D0\uB294 \uC0B0\uCC45\uC744 \uB098\uAC00 \uC9D1\uC744
      \uBE44\uC6C1\uB2C8\uB2E4. \uB0A0\uC9DC\uC5D0 \uB530\uB978 \uC704\uCE58 \uBCC0\uD654\uB97C
      \uD65C\uC6A9\uD574 \uC2E0\uC790\uC758 \uC874\uC7AC\uB97C \uC99D\uBA85\uD558\uAC70\uB098
      \uC880\uB3C4\uB451\uC758 \uD45C\uC801\uC774 \uB429\uB2C8\uB2E4."
  - RoleName: "\uAC81\uC7C1\uC774"
    RoleIcon: {fileID: 5575286031740401903, guid: e32e47ad06ae6044baf7f237db764fa7, type: 3}
    RoleDescription: "\uB9C8\uB140\uC758 \uC0B4\uD574 \uB300\uC0C1\uC5D0\uC11C \uC81C\uC678\uB418\uB294
      \uD2B9\uAD8C\uC744 \uAC00\uC84C\uC9C0\uB9CC, \uADF9\uB3C4\uC758 \uACF5\uD3EC\uB85C
      \uC778\uD574 \uC2E0\uC790\uC758 \uAE30\uB3C4\uB9C8\uC800 \uAC70\uBD80\uD558\uACE0
      \uC624\uC9C1 \uCE68\uBB35(\"...\")\uB9CC \uC720\uC9C0\uD569\uB2C8\uB2E4. \uB2E8,
      \uCC98\uD615 \uC9C1\uC804 \uD074\uB9AD\uB420 \uB54C\uB9CC\uC740 \uCE68\uBB35\uC744
      \uBC97\uC5B4\uB0A9\uB2C8\uB2E4."
  - RoleName: "\uBC99\uC5B4\uB9AC"
    RoleIcon: {fileID: -7851689105034627237, guid: a78f34a6db5eea04f9ea8cc1b4e1a1da, type: 3}
    RoleDescription: "\uC5B4\uB5A0\uD55C \uC0C1\uD669\uC5D0\uC11C\uB3C4, \uC2EC\uC9C0\uC5B4
      \uB9C8\uB140\uAC00 \uCD1D\uAD6C\uB97C \uACA8\uB204\uB294 \uC704\uD611 \uC18D\uC5D0\uC11C\uB3C4
      \uC624\uC9C1 \uCE68\uBB35(\"...\")\uC73C\uB85C \uC77C\uAD00\uD569\uB2C8\uB2E4.
      \uC544\uBB34\uB7F0 \uBC18\uC751\uC744 \uD558\uC9C0 \uC54A\uC74C\uC73C\uB85C\uC368
      \uC790\uC2E0\uC758 \uC815\uCCB4\uB97C \uCCA0\uC800\uD788 \uC228\uAE30\uB294
      \uBBF8\uC2A4\uD130\uB9AC\uD55C \uC778\uBB3C\uC785\uB2C8\uB2E4."
  - RoleName: "\uC2DC\uBBFC"
    RoleIcon: {fileID: -7749395267196790961, guid: 842f130dc9862c34f9291121e68c6374, type: 3}
    RoleDescription: "\uBC24\uC0AC\uC774 \uC2E0\uC790\uAC00 \uBC29\uBB38\uD558\uC5EC
      \uAE30\uB3C4\uB97C \uC62C\uB838\uB294\uC9C0 \uC5EC\uBD80\uB97C \uB0AE\uC5D0
      \uC815\uC9C1\uD558\uAC8C \uC99D\uC5B8\uD569\uB2C8\uB2E4. \uD2B9\uBCC4\uD55C
      \uB2A5\uB825\uC740 \uC5C6\uC9C0\uB9CC, \uC8FC\uBBFC\uB4E4 \uAC04\uC758 \uC99D\uC5B8\uC744
      \uB9DE\uCDB0\uBCF4\uBA70 \uB9C8\uB140\uB97C \uCC3E\uC544\uB0B4\uB294 \uB370
      \uACB0\uC815\uC801\uC778 \uC5ED\uD560\uC744 \uD569\uB2C8\uB2E4."
