  - RoleName: "\uC880\uB3C4\uB451"
    RoleIcon: {fileID: 21300000, guid: 04a26af393c8742a3bdf84b43bed6c16, type: 3}
    RoleDescription: "\uC880\uB3C4\uB451\uC740 \uBC24\uC5D0 \uB9C8\uB140\uC758 \uC9D1\uACFC
      \uB9C8\uB140\uAC00 \uC2B5\uACA9\uD558\uB294 \uC9D1\uC744 \uC81C\uC678\uD55C
      \uBE44\uC5B4\uC788\uB294 \uC9D1 \uC911 \uD55C \uACF3\uC5D0 \uCE68\uC785\uD558\uC5EC
      \uB3C4\uB451\uC9C8\uC744 \uD569\uB2C8\uB2E4. \uB3C4\uB451\uC9C8\uC744 \uC131\uACF5
      \uD588\uC744 \uACBD\uC6B0 \uC99D\uC5B8 \uC2DC \uAC70\uC9D3\uB9D0\uC744, \uC2E4\uD328
      \uD588\uC744 \uACBD\uC6B0 \uC9C4\uC2E4\uC744 \uB9D0\uD569\uB2C8\uB2E4.\t"
  - RoleName: "\uBC99\uC5B4\uB9AC"
    RoleIcon: {fileID: 0}
    RoleDescription: "\uBC99\uC5B4\uB9AC"
  - RoleName: "\uAC81\uC7C1\uC774"
    RoleIcon: {fileID: 0}
    RoleDescription: "\uAC81\uC7C1\uC774\uB294 \uBC24\uC5D0 \uC808\uB300\uB85C \uBC16\uC5D0
      \uB098\uAC00\uC9C0 \uC54A\uC73C\uBA70, \uBB38\uC744 \uAC78\uC5B4\uC7A0\uAD88
      \uADF8 \uB204\uAD6C\uC640\uB3C4 \uB9CC\uB098\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.
      \uB530\uB77C\uC11C \uB9C8\uB140\uC758 \uCE68\uC785\uC5D0\uB3C4 \uBB34\uC0AC\uD558\uACE0
      \uC544\uBB34 \uB9D0\uB3C4 \uD558\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4. \uB610\uD55C,
      \uCD1D\uC744 \uC3D8\uAE30 \uC9C1\uC804 \uC774\uC0C1\uBC18\uC751\uC744 \uBCF4\uC785\uB2C8\uB2E4."
  - RoleName: "\uBD88\uBA74\uC99D"
    RoleIcon: {fileID: 0}
    RoleDescription: "\uBD88\uBA74\uC99D\uC740 \uC9DD\uC218 \uBC24\uC5D0\uB294 \uC0B0\uCC45\uC73C\uB85C
      \uC9D1\uC744 \uBE44\uC6B0\uACE0, \uD640\uC218 \uBC24\uC5D0\uB294 \uC9D1\uC5D0
      \uBA38\uBB3C\uB7EC \uC788\uC2B5\uB2C8\uB2E4."
  - RoleName: "\uC2DC\uBBFC"
    RoleIcon: {fileID: 0}
    RoleDescription: "\uB9C8\uC744\uC5D0 \uC0AC\uB294 \uD3C9\uBC94\uD55C \uC0AC\uB78C\uC785\uB2C8\uB2E4."
