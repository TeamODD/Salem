        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: Dialogue_08
    Type: 0
    Message: "[\uB118\uAE30\uAE30]\uB97C \uB204\uB974\uBA74 \uC218\uC0AC\uB97C\n\uC885\uB8CC\uD558\uACE0
      \uBC24\uC73C\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4."
    TargetObject: {fileID: 1301539121}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
