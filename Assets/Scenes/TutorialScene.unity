  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialStage
  StageIndex: 0
  StageDescription: "UI & \uAC8C\uC784 \uC870\uC791 \uC124\uBA85"
  IntroData:
    ShowIntro: 1
    RoundTitle: "\uD29C\uD1A0\uB9AC\uC5BC 01"
    SituationDescription: "UI \uBC0F \uAC8C\uC784 \uC870\uC791"
  RoleDatabase: {fileID: 11400000, guid: f4a82abd194fd514a8590a226ded1788, type: 2}
  StageRoleNames: []
  Steps:
  - StepName: Dialogue_01
    Type: 0
    Message: "\uB9C8\uC744\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4.
      \n\uC774\uACF3\uC740 \uAC89\uBCF4\uAE30\uC5D4 \uD3C9\uD654\uB86D\uC9C0\uB9CC,\n\uAC70\uB300\uD55C
      \uBE44\uBC00\uC774 \uC228\uACA8\uC838 \uC788\uC2B5\uB2C8\uB2E4."
    TargetObject: {fileID: 0}
    UseHighlight: 0
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: Dialogue_02
    Type: 0
    Message: "\uD604\uC7AC \uC774 \uB9C8\uC744\uC5D0\uB294 1\uBA85\uC758 \uB9C8\uB140\uAC00
      \n\uC815\uCCB4\uB97C \uC228\uAE34 \uCC44 \uC8FC\uBBFC\uB4E4 \uC0AC\uC774\uC5D0
      \uC11E\uC5EC\n\uC0B4\uACE0 \uC788\uB2E4\uB294 \uC18C\uBB38\uC774 \uB3CC\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    TargetObject: {fileID: 0}
    UseHighlight: 0
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: Dialogue_03
    Type: 0
    Message: "\uC800\uAE30 \uC758\uC790\uC5D0 \uC549\uC544 \uC788\uB294\n\uB178\uC778\uC774
      \uBCF4\uC774\uC2DC\uB098\uC694? \n\uADF8\uC758 \uC774\uB984\uC740 \uC5D0\uB4DC\uBA3C\uB4DC\uC785\uB2C8\uB2E4."
    TargetObject: {fileID: 595283740}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: Dialogue_04
    Type: 0
    Message: "\uC778\uBB3C\uC744 \uD074\uB9AD\uD558\uC5EC \uC804\uB0A0 \uBC24\uC758
      \n\uD589\uB3D9\uC744 \uC2EC\uBB38\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    TargetObject: {fileID: 595283740}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: Dialogue_05
    Type: 0
    Message: "\uC544\uC774\uCF58\uC744 \uD074\uB9AD\uD574 \uC778\uBB3C\uC758 \n\uC758\uC2EC
      \uD2B9\uC131\uC744 \uBA54\uBAA8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    TargetObject: {fileID: 1488721079}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: Dialogue_06
    Type: 0
    Message: "\uB9C8\uB140\uB85C \uD655\uC2E0\uB418\uB294 \uC778\uBB3C\uC774 \uC788\uB2E4\uBA74
      \n\uC7A5\uC804 \uD6C4 \uCC98\uD615\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    TargetObject: {fileID: 196054555}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: Dialogue_07
    Type: 0
    Message: "\uD604\uC7AC \uB9C8\uB140\uB97C \uD2B9\uC815\uD560 \uC218 \uC5C6\uB2E4\uBA74,
      \n\uD558\uB8E8\uB97C \uB118\uAE30\uB294 \uAC83\uB3C4 \uBC29\uBC95\uC785\uB2C8\uB2E4."
    TargetObject: {fileID: 110093771}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: Dialogue_08
    Type: 0
    Message: "[\uB118\uAE30\uAE30]\uB97C \uB204\uB974\uBA74 \uC218\uC0AC\uB97C\n\uC885\uB8CC\uD558\uACE0
      \uBC24\uC73C\uB85C \uB118\uC5B4\uAC11\uB2C8\uB2E4."
    TargetObject: {fileID: 110093771}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
