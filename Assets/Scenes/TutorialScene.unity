  - StepName: "\uC99D\uC5B8\uB2E8\uACC4"
    Type: 3
    Message: "\uCE90\uB9AD\uD130\uB97C \uD074\uB9AD\uD558\uC5EC \uC99D\uC5B8\uC744
      \uB4E4\uC73C\uC138\uC694."
