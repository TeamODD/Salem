--- !u!114 &926797740
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 926797739}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ce8fd23b6f9b6f64faa359a918cfee96, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialManager
  Steps:
  - Message: "\uB9C8\uC744\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4.
      \uC774\uACF3\uC740 \uAC89\uBCF4\uAE30\uC5D0 \uD3C9\uD654\uB85C\uC6CC \uBCF4\uC774\uC9C0\uB9CC,
      \uAC70\uB300\uD55C \uBE44\uBC00\uC774 \uC228\uACA8\uC838 \uC788\uC2B5\uB2C8\uB2E4."
    DialoguePosition: {x: 0, y: -450}
    TargetUI: {fileID: 0}
    TargetWorld: {fileID: 0}
    UseHighlight: 0
    WorldCircleSize: 500
    Padding: 1.2
  - Message: "\uD604\uC7AC \uC774 \uB9C8\uC744\uC5D0\uB294 1\uBA85\uC758 \uB9C8\uB140\uAC00
      \uC815\uCCB4\uB97C \uC228\uAE34 \uCC44 \uC8FC\uBBFC\uB4E4 \uC0AC\uC774\uC5D0
      \uC11E\uC5EC \uC0B4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    DialoguePosition: {x: 0, y: -450}
    TargetUI: {fileID: 0}
    TargetWorld: {fileID: 0}
    UseHighlight: 0
    WorldCircleSize: 500
    Padding: 1.2
  - Message: "\uC218\uC0C1\uD55C \uC778\uBB3C\uC744 \uBC1C\uACAC\uD588\uB2E4\uBA74
      \uD074\uB9AD\uD558\uC5EC \uC2EC\uBB38\uC744 \uC2DC\uC791\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC9C4\uC2E4\uC740 \uD56D\uC0C1 \uC758\uC678\uC758 \uACF3\uC5D0 \uC788\uB294
      \uBC95\uC774\uC8E0."
    DialoguePosition: {x: 0, y: -450}
    TargetUI: {fileID: 0}
    TargetWorld: {fileID: 358819359}
    UseHighlight: 1
    WorldCircleSize: 500
    Padding: 1.2
  - Message: "\uC544\uC774\uCF58\uC744 \uB204\uB974\uBA74 \uB300\uC0C1\uC758 \uC758\uC2EC\uB418\uB294
      \uD2B9\uC131\uC744 \uBA54\uBAA8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    DialoguePosition: {x: 400, y: 100}
    TargetUI: {fileID: 1512332909}
    TargetWorld: {fileID: 0}
    UseHighlight: 1
    WorldCircleSize: 500
    Padding: 1.2
  - Message: "\uC7A5\uC804 \uD6C4 \uB300\uC0C1\uC744 \uD074\uB9AD\uD558\uC5EC \uCC98\uD615\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    DialoguePosition: {x: 300, y: -300}
    TargetUI: {fileID: 27822534}
    TargetWorld: {fileID: 0}
    UseHighlight: 1
    WorldCircleSize: 500
    Padding: 1.2
  - Message: "\uB9CC\uC57D \uD604\uC7AC \uB9C8\uB140\uB97C \uD2B9\uC815\uD560 \uC218
      \uC5C6\uB2E4\uBA74, \uD558\uB8E8\uB97C \uB118\uAE30\uB294 \uAC83\uB3C4 \uBC29\uBC95\uC785\uB2C8\uB2E4."
