        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: Dialogue_02
    Type: 0
    Message: "\uB9C8\uB140\uC640 \uC880\uB3C4\uB451, \uADF8\uB9AC\uACE0 \uC9C4\uC9DC
      \uC2E0\uC790 \uBAA8\uB450\uAC00 \uC790\uC2E0\uC744 \uC2E0\uC790\uB77C\uACE0
      \uC8FC\uC7A5\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4. \uB204\uAC00 \uC9C4\uC9DC\uC77C\uAE4C\uC694?"
