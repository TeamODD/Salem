--- !u!114 &1627554873
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1627554872}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e7bdf9781aa74ff49983a842fec8695b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::TutorialStage
  StageIndex: 0
  StageDescription: "UI & \uAC8C\uC784 \uC870\uC791 \uC124\uBA85"
  IntroData:
    ShowIntro: 1
    RoundTitle: "\uD29C\uD1A0\uB9AC\uC5BC 01"
    SituationDescription: "UI \uBC0F \uAC8C\uC784 \uC870\uC791"
  RoleDatabase: {fileID: 11400000, guid: f4a82abd194fd514a8590a226ded1788, type: 2}
  StageRoleNames: []
  Steps:
  - StepName: Dialogue_01
    Type: 0
    Message: "\uB9C8\uC744\uC5D0 \uC624\uC2E0 \uAC83\uC744 \uD658\uC601\uD569\uB2C8\uB2E4.
      \n\uC774\uACF3\uC740 \uAC89\uBCF4\uAE30\uC5D4 \uD3C9\uD654\uB86D\uC9C0\uB9CC,\n\uAC70\uB300\uD55C
      \uBE44\uBC00\uC774 \uC228\uACA8\uC838 \uC788\uC2B5\uB2C8\uB2E4."
    TargetObject: {fileID: 0}
    UseHighlight: 0
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: "\uCE90\uB9AD\uD130 \uC124\uBA85"
    Type: 0
    Message: "\uB9C8\uC744\uC5D0 \uC0B4\uACE0 \uC788\uB294 \uC0AC\uB78C\uB4E4\uC744
      \uC18C\uAC1C\uD574\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
    TargetObject: {fileID: 0}
    UseHighlight: 0
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: "\uCE90\uB9AD\uD130 \uC124\uBA85 <\uACE0\uB4DC\uB9AD>"
    Type: 0
    Message: "\uACE0\uB4DC\uB9AD \u2014 \uB9C8\uC744 \uC678\uACFD\uC758 \uB18D\uBD80.
      \uC785\uC774 \uAC70\uCE60\uACE0 \uB298 \uD53C\uACE4\uD574\uD558\uC9C0\uB9CC,
      \uC2DD\uAD6C\uB4E4 \uBC25\uB9CC\uD07C\uC740 \uC808\uB300 \uAD76\uAE30\uC9C0
      \uC54A\uB294 \uAC00\uC7A5\uC774\uB2E4."
    TargetObject: {fileID: 599448270}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 700
    UIPadding: 1.2
  - StepName: "\uCE90\uB9AD\uD130 \uC124\uBA85 <\uC624\uC2A4\uC648\uB4DC>"
    Type: 0
    Message: "\uC624\uC2A4\uC648\uB4DC \u2014 \uB3C8 \uB9CE\uC740 \uB9C8\uC744 \uC0C1\uC778.
      \uBAA8\uB4E0 \uAC83\uC744 \uC774\uC775\uC73C\uB85C \uB530\uC9C0\uBA70 \uB2A5\uCCAD\uC2A4\uB7EC\uC6B4
      \uB9D0\uC19C\uC528\uB85C \uC0C1\uD669\uC744 \uC790\uAE30 \uD3B8\uC73C\uB85C
      \uB04C\uC5B4\uAC04\uB2E4."
    TargetObject: {fileID: 1456692274}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 700
    UIPadding: 1.2
  - StepName: "\uCE90\uB9AD\uD130 \uC124\uBA85 <\uC5D0\uB4DC\uBA3C\uB4DC>"
    Type: 0
    Message: "\uC5D0\uB4DC\uBA3C\uB4DC \u2014 \uD640\uB85C \uC0AC\uB294 \uB9C8\uC744
      \uCD5C\uACE0\uB839 \uB178\uC778. \uB9D0\uC218\uAC00 \uC801\uACE0 \uC5B4\uB20C\uD558\uC9C0\uB9CC
      \uB9C8\uC744 \uC0AC\uC815\uC744 \uB204\uAD6C\uBCF4\uB2E4 \uC624\uB798 \uC9C0\uCF1C\uBD10
      \uC654\uB2E4."
    TargetObject: {fileID: 595283740}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 700
    UIPadding: 1.2
  - StepName: "\uCE90\uB9AD\uD130 \uC124\uBA85 <\uB12C>"
    Type: 0
    Message: "\uB12C \u2014 \uC601\uC8FC\uC131\uC5D0\uC11C \uC77C\uD558\uB294 \uBA54\uC774\uB4DC.
      \uC190\uBC84\uB987\uC774 \uC88B\uC9C0 \uC54A\uACE0 \uB208\uCE58\uB97C \uB9CE\uC774
      \uC0B4\uD53C\uBA70, \uC9C0\uBAA9\uB2F9\uD558\uBA74 \uB2F9\uD669\uD574 \uB9D0\uC744
      \uB354\uB4EC\uB294\uB2E4."
    TargetObject: {fileID: 1279020036}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 700
    UIPadding: 1.2
  - StepName: "\uCE90\uB9AD\uD130 \uC124\uBA85 <\uD790\uB2E4>"
    Type: 0
    Message: "\uD790\uB2E4 \u2014 \uC18C\uBB38\uC5D0 \uBC1D\uC740 \uC5EC\uAD00 \uC8FC\uC778.
      \uC785\uC774 \uAC00\uBCCD\uACE0 \uB0A8 \uD5D8\uB2F4\uC744 \uC798 \uD558\uBA70,
      \uD6C4\uD55C \uCC99\uD558\uBA74\uC11C\uB3C4 \uAC12\uC740 \uBE44\uC2F8\uAC8C
      \uBC1B\uC73C\uB824 \uD55C\uB2E4."
    TargetObject: {fileID: 1619104776}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 700
    UIPadding: 1.2
  - StepName: Dialogue_02
    Type: 0
    Message: "\uD604\uC7AC \uC774 \uB9C8\uC744\uC5D0\uB294 1\uBA85\uC758 \uB9C8\uB140\uAC00
      \n\uC815\uCCB4\uB97C \uC228\uAE34 \uCC44 \uC8FC\uBBFC\uB4E4 \uC0AC\uC774\uC5D0
      \uC11E\uC5EC\n\uC0B4\uACE0 \uC788\uB2E4\uB294 \uC18C\uBB38\uC774 \uB3CC\uACE0
      \uC788\uC2B5\uB2C8\uB2E4."
    TargetObject: {fileID: 0}
    UseHighlight: 0
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: Dialogue_04
    Type: 0
    Message: "\uC778\uBB3C\uC744 \uD074\uB9AD\uD558\uC5EC \uC804\uB0A0 \uBC24\uC758
      \n\uD589\uB3D9\uC744 \uC2EC\uBB38\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    TargetObject: {fileID: 595283740}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: Dialogue_05
    Type: 0
    Message: "\uC544\uC774\uCF58\uC744 \uD074\uB9AD\uD574 \uC778\uBB3C\uC758 \n\uC758\uC2EC
      \uD2B9\uC131\uC744 \uBA54\uBAA8\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    TargetObject: {fileID: 874279216}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 100
    UIPadding: 1.2
  - StepName: Dialogue_06
    Type: 0
    Message: "\uB9C8\uB140\uB85C \uD655\uC2E0\uB418\uB294 \uC778\uBB3C\uC774 \uC788\uB2E4\uBA74
      \n\uC7A5\uC804 \uD6C4 \uCC98\uD615\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    TargetObject: {fileID: 1394791000}
    UseHighlight: 1
    DialoguePosition: {x: 0, y: 0}
    UseCustomPos: 0
    OnStepStart:
      m_PersistentCalls:
        m_Calls: []
    OnStepComplete:
      m_PersistentCalls:
        m_Calls: []
    WorldCircleSize: 500
    UIPadding: 1.2
  - StepName: Dialogue_07
    Type: 0
    Message: "\uD604\uC7AC \uB9C8\uB140\uB97C \uD2B9\uC815\uD560 \uC218 \uC5C6\uB2E4\uBA74,
      \n\uD558\uB8E8\uB97C \uB118\uAE30\uB294 \uAC83\uB3C4 \uBC29\uBC95\uC785\uB2C8\uB2E4."
